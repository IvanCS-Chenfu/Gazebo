<?xml version="1.0"?>
<robot name="box_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="base_link">
  <visual>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.4 0.2 1"/>
    </geometry>
    <material name="blue">
      <color rgba="0 0 1 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.4 0.2 1"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <mass value="2.0"/>
    <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0.0" ixz="0.0" iyz="0.0"/>
  </inertial>
</link>

<joint name="joint1" type="fixed">
  <parent link="base_link"/>
  <child link="link1"/>
  <origin xyz="0 0 0" rpy="0 0 0"/> <!--0 0 1.57-->
</joint>

<link name="link1">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <geometry>
      <box size="0.4 0.2 1"/>
    </geometry>
    <material name="blue">
      <color rgba="0 0 1 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <geometry>
      <box size="0.4 0.2 1"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <mass value="2.0"/>
    <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0.0" ixz="0.0" iyz="0.0"/>
  </inertial>
</link>

<joint name="joint2" type="fixed">
  <parent link="link1"/>
  <child link="link2"/>
  <origin xyz="0 0 0" rpy="0 0 0"/> <!--0 0 1.57-->
</joint>

<link name="link2">
  <visual>
    <origin xyz="0 0 1" rpy="0 0 0"/>
    <geometry>
      <box size="0.4 0.2 1"/>
    </geometry>
    <material name="blue">
      <color rgba="0 0 1 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 1" rpy="0 0 0"/>
    <geometry>
      <box size="0.4 0.2 1"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 1" rpy="0 0 0"/>
    <mass value="2.0"/>
    <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0.0" ixz="0.0" iyz="0.0"/>
  </inertial>
</link>



</robot>